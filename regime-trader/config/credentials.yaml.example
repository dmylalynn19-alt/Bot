# ==============================================================================
# Example credentials file.
#
# Copy this file to credentials.yaml and fill in real values. credentials.yaml
# is gitignored and must never be committed. Prefer the .env file / environment
# variables for secrets where possible; this file exists for tooling that
# expects YAML-based credentials.
# ==============================================================================

alpaca:
  api_key: "your_key_here"
  secret_key: "your_secret_here"
  paper: true
