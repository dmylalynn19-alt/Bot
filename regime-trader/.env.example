ALPACA_API_KEY=your_key_here
ALPACA_SECRET_KEY=your_secret_here
ALPACA_PAPER=true

# Schwab (developer.schwab.com - register an app, get these from its detail
# page). SCHWAB_CALLBACK_URL must exactly match your app's registered
# callback URL (case and trailing slash included). SCHWAB_TOKEN_PATH is
# where the OAuth token is cached after the first (interactive, one-time)
# login - it does not exist yet on first run, so leave the default unless
# you want it elsewhere.
SCHWAB_API_KEY=your_app_key_here
SCHWAB_APP_SECRET=your_app_secret_here
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182/
SCHWAB_TOKEN_PATH=schwab_token.json
